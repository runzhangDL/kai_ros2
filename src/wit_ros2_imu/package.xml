<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wit_ros2_imu</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="bgzerol@todo.todo">bgzerol</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <!-- Declared to match what the driver actually imports. The manufacturer's
       package.xml listed only rclpy, so colcon did not know imu_msg has to be
       built first, and rosdep could not install the serial/numpy deps. The
       Python sources are unchanged. -->
  <depend>sensor_msgs</depend>
  <depend>imu_msg</depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
